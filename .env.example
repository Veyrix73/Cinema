# Copy this file to .env for local development.
# Use a PostgreSQL database URL from your hosting provider.
DATABASE_URL=postgresql://postgres:password@localhost:5432/dancing_fruit_cinema
# Generate a long random value (at least 32 characters).
SESSION_SECRET=replace-with-a-long-random-secret
# The first administrator is created from these server environment variables.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=replace-with-a-long-unique-password
PORT=3000
NODE_ENV=development

# Public origin of the deployed website (no trailing slash).
APP_BASE_URL=https://your-cinema.onrender.com
# Optional social sign-in. Leave blank until OAuth apps are configured.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=
